<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is here only for NotifyIcon: the tray icon has no WPF equivalent,
         and taking it from the framework avoids an external tray package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>T4Power</RootNamespace>
    <AssemblyName>T4Power</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Embedded in the PE so Explorer, the taskbar and the title bar have an icon.
         Regenerate it by running the IconGen tool under tools/IconGen. -->
    <ApplicationIcon>Assets\t4power.ico</ApplicationIcon>

    <!-- One exe, several modes (tray UI, service, CLI), so we need our own entry point.
         Leaving App.xaml as ApplicationDefinition would make the WPF targets generate a
         competing Main. -->
    <StartupObject>T4Power.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <Version>0.1.0</Version>
    <Product>T4Power</Product>
    <Description>Power and clock manager for NVIDIA GPUs (Tesla T4)</Description>
    <Authors>Pierre-Olivier Boulant</Authors>
    <Copyright>Copyright (C) 2026 Pierre-Olivier Boulant</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/pob31/t4power</RepositoryUrl>
  </PropertyGroup>

  <!-- App.xaml needs no explicit item: with EnableDefaultApplicationDefinition false it is
       picked up by the SDK's default Page glob, which is exactly what we want. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!-- ServiceController, for querying and waiting on the service during install/uninstall,
         and for probing and starting the PawnIO driver that fan control needs. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />

    <!-- Motherboard fan control (MPL-2.0, which GPL-3.0 permits linking under section 3.3).
         Deliberately NOT referenced by T4Power.Core: it pulls in six transitive packages and
         reaches hardware through a kernel driver, and Core's zero-package property is what
         keeps the unit tests hardware-free. See T4Power.Core.Fans.IFanHardware for the seam.

         Never enable PublishTrimmed with this: LibreHardwareMonitor is reflection-heavy and
         would fail silently at runtime rather than at build time. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also as a resource, so the WPF window and the tray icon can load it at runtime. -->
    <Resource Include="Assets\t4power.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\T4Power.Core\T4Power.Core.csproj" />
  </ItemGroup>

</Project>
