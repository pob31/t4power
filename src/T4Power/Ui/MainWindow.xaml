<Window x:Class="T4Power.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:T4Power.Ui"
        Title="T4Power" Height="760" Width="820"
        MinHeight="420" MinWidth="700"
        Icon="/Assets/t4power.ico"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1D22">

  <Window.Resources>
    <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
    <ui:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />

    <SolidColorBrush x:Key="Fg" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="FgDim" Color="#FFA8AEB6" />
    <SolidColorBrush x:Key="Card" Color="#FF24272E" />
    <SolidColorBrush x:Key="Accent" Color="#FF76B900" />
    <SolidColorBrush x:Key="Warn" Color="#FFE8A33D" />
    <!-- GPU names: the one thing you scan for first, so give it its own colour. -->
    <SolidColorBrush x:Key="Title" Color="#FFFFCC33" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <!-- Explicit, because an implicit TextBlock style is not reliably picked up by bare
         TextBlocks inside a DataTemplate - which left the GPU names dark on a dark card.
         The root Grid also sets TextElement.Foreground so the colour cascades regardless. -->
    <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Title}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Dim" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource FgDim}" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="Metric" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="#FF31353E" />
      <Setter Property="BorderBrush" Value="#FF444952" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding Border.BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF3C424D" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="#FF1B1D22" />
      <Setter Property="BorderBrush" Value="#FF444952" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
    </Style>
  </Window.Resources>

  <!-- TextElement.Foreground is inherited down the whole tree, so every TextBlock that does
       not set its own colour picks this up. This is the safety net that stops any label
       rendering in the default near-black on these dark cards. -->
  <Grid TextElement.Foreground="{StaticResource Fg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Service status banner -->
    <Border Grid.Row="0" Padding="14,10" Background="#FF2A2E36">
      <DockPanel>
        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource Accent}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ServiceAvailable}" Value="False">
                  <Setter Property="Fill" Value="#FFD24B4B" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <Button DockPanel.Dock="Right" Content="Install service" Margin="8,0,0,0"
                Click="InstallService_Click"
                Visibility="{Binding ServiceAvailable, Converter={StaticResource NotBoolToVis}}" />
        <TextBlock Text="{Binding ServiceStatus}" VerticalAlignment="Center"
                   Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Horizontal scrolling stays Disabled so cards are measured against the viewport width
         and wrap/trim to fit. Any other value hands the content infinite width to lay out in. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="14,12">
      <StackPanel>
      <ItemsControl ItemsSource="{Binding Gpus}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource Card}" CornerRadius="8" Padding="16" Margin="0,0,0,14">
              <StackPanel>

                <!-- Identity -->
                <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

                <!-- Live metrics -->
                <UniformGrid Columns="5" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="{Binding PowerText}" Style="{StaticResource Metric}" />
                    <TextBlock Text="{Binding PowerLimitText}" Style="{StaticResource Dim}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding ClockText}" Style="{StaticResource Metric}" />
                    <TextBlock Text="SM clock" Style="{StaticResource Dim}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding TempText}" Style="{StaticResource Metric}" />
                    <TextBlock Text="temperature" Style="{StaticResource Dim}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding UtilText}" Style="{StaticResource Metric}" />
                    <TextBlock Text="utilisation" Style="{StaticResource Dim}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding PStateText}" Style="{StaticResource Metric}" />
                    <TextBlock Text="p-state" Style="{StaticResource Dim}" />
                  </StackPanel>
                </UniformGrid>

                <TextBlock Text="{Binding ThrottleText}" Foreground="{StaticResource Warn}"
                           FontSize="12" Margin="0,10,0,0"
                           Visibility="{Binding HasThrottle, Converter={StaticResource BoolToVis}}" />

                <!-- Unmanaged notice -->
                <Border Background="#FF2E323B" CornerRadius="6" Padding="12" Margin="0,14,0,0"
                        Visibility="{Binding Managed, Converter={StaticResource NotBoolToVis}}">
                  <StackPanel>
                    <TextBlock Text="Not managed by T4Power" FontWeight="SemiBold"
                               Style="{StaticResource Body}" />
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="This GPU is monitored but never written to. T4Power manages the Tesla T4 by default; clamping a display adapter would do more harm than good." />
                    <Button Content="Manage this GPU" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Click="ManageGpu_Click" />
                  </StackPanel>
                </Border>

                <!-- Controls -->
                <StackPanel Visibility="{Binding Managed, Converter={StaticResource BoolToVis}}">

                  <Border Background="#FF2E323B" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                    <StackPanel>
                      <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Style="{StaticResource Body}" />
                      <TextBlock Text="{Binding OverrideExpiryText}" Style="{StaticResource Dim}" Margin="0,3,0,0"
                                 Visibility="{Binding HasOverrideExpiry, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                  </Border>

                  <!-- Presets -->
                  <ItemsControl ItemsSource="{Binding ProfileNames}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding}" Click="Preset_Click" Margin="0,0,6,6" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <WrapPanel>
                    <Button Content="Boost 30 min" Click="Boost_Click" />
                    <Button Content="Back to automatic" Click="Auto_Click" />
                    <Button Content="Restore defaults" Click="Restore_Click" />
                  </WrapPanel>

                  <!-- Power slider -->
                  <StackPanel Margin="0,18,0,0"
                              Visibility="{Binding SupportsPowerLimit, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Dim}">
                        <Run Text="{Binding PowerSliderW, StringFormat={}{0:0} W, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="Power limit" Style="{StaticResource Body}" />
                    </DockPanel>
                    <!-- Commit on release / key-up only. Binding the setter straight to the
                         service would write once per pixel of drag, and would also fire on
                         programmatic updates from the poll loop. -->
                    <Slider Minimum="{Binding MinPowerW}" Maximum="{Binding MaxPowerW}"
                            Value="{Binding PowerSliderW, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                            Thumb.DragStarted="Slider_DragStarted"
                            Thumb.DragCompleted="Slider_DragCompleted"
                            KeyUp="Slider_KeyUp" />
                    <TextBlock Style="{StaticResource Dim}">
                      <Run Text="{Binding MinPowerW, StringFormat={}{0:0} W, Mode=OneWay}" />
                      <Run Text=" to " />
                      <Run Text="{Binding MaxPowerW, StringFormat={}{0:0} W, Mode=OneWay}" />
                      <Run Text=" — only bounds sustained load, not idle draw" />
                    </TextBlock>
                  </StackPanel>

                  <!-- Clock lock -->
                  <StackPanel Margin="0,16,0,0">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Dim}">
                        <Run Text="{Binding ClockSliderMhz, StringFormat={}{0} MHz, Mode=OneWay}" />
                      </TextBlock>
                      <!-- Click, not Checked/Unchecked: those also fire when the poll loop
                           updates the box, which would echo the service's own state back at it. -->
                      <CheckBox Content="Pin SM clock" FontSize="12"
                                IsChecked="{Binding ClockLockEnabled, Mode=TwoWay}"
                                Click="ClockLock_Click" />
                    </DockPanel>
                    <Slider Minimum="{Binding MinClockMhz}" Maximum="{Binding MaxClockMhz}"
                            Value="{Binding ClockSliderMhz, Mode=TwoWay}"
                            TickFrequency="15" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                            IsEnabled="{Binding ClockLockEnabled}"
                            Thumb.DragStarted="Slider_DragStarted"
                            Thumb.DragCompleted="Slider_DragCompleted"
                            KeyUp="Slider_KeyUp" />
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                               Text="Holds the clock at exactly this value. Pin at the maximum to force P0 and keep performance steady; pin low to cut idle draw and heat. Unpinned, the card manages itself and drops to P8 when idle." />
                    <TextBlock Foreground="{StaticResource Warn}" FontSize="11" Margin="0,4,0,0"
                               Text="This GPU refused a clock lock; only the power limit applies."
                               Visibility="{Binding ClockLockRefused, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>

                  <!-- Watchlist: the auto-switch rule users actually need to configure -->
                  <StackPanel Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource Body}">
                      <Run Text="Hold" />
                      <Run Text="{Binding WatchTargetProfile, Mode=OneWay}" FontWeight="SemiBold"
                           Foreground="{StaticResource Title}" />
                      <Run Text="while these apps are running" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Matched by executable name, so it is found wherever it lives — a build output or Program Files alike. The card ramps up before the app touches the GPU, and holds until it exits." />

                    <ItemsControl ItemsSource="{Binding WatchedApps}" Margin="0,8,0,0"
                                  Visibility="{Binding HasWatchedApps, Converter={StaticResource BoolToVis}}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#FF31353E" CornerRadius="12" Padding="10,4"
                                  Margin="0,0,6,6">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Content="✕" Margin="8,0,0,0"
                                      Padding="4,0" BorderThickness="0" Background="Transparent"
                                      ToolTip="Stop watching this app"
                                      Click="RemoveWatch_Click" />
                              <TextBlock Text="{Binding}" Style="{StaticResource Body}"
                                         VerticalAlignment="Center" />
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,6,0,0">
                      <Button DockPanel.Dock="Right" Content="Add" Margin="6,0,0,0"
                              Click="AddWatch_Click" />
                      <TextBox Text="{Binding NewAppName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               KeyDown="NewApp_KeyDown" />
                    </DockPanel>
                  </StackPanel>

                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ============================ Motherboard fan control ============================ -->
      <StackPanel Visibility="{Binding ShowFanSection, Converter={StaticResource BoolToVis}}">

        <!-- Why fan control is not working, and what to do about it. Almost always PawnIO. -->
        <Border Background="{StaticResource Card}" CornerRadius="8" Padding="16" Margin="0,0,0,14"
                Visibility="{Binding FanControlAvailable, Converter={StaticResource NotBoolToVis}}">
          <StackPanel>
            <TextBlock Text="Fan control unavailable" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{Binding FanUnavailableReason}" Style="{StaticResource Body}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Everything else works normally — fan control is an optional extra on top of GPU power and clock management." />
            <Button Content="Get PawnIO" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Click="GetPawnIo_Click"
                    Visibility="{Binding HasFanHelpUrl, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Border>

        <!-- Adoption. Nothing is ever driven until someone picks a header here. -->
        <Border Background="{StaticResource Card}" CornerRadius="8" Padding="16" Margin="0,0,0,14"
                Visibility="{Binding ShowFanAdoption, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Motherboard fan headers" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Identify spins a header to full for ten seconds so you can hear which fan it is. Adopt only the one cooling the GPU — the rest should stay on their BIOS curves." />

            <ItemsControl ItemsSource="{Binding AvailableFanChannels}" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FF2E323B" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Adopt" Click="AdoptFan_Click"
                              Margin="6,0,0,0"
                              IsEnabled="{Binding DataContext.CanAdoptFan,
                                          RelativeSource={RelativeSource AncestorType=Window}}" />
                      <Button DockPanel.Dock="Right" Content="Identify" Click="IdentifyChannel_Click" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding Identifier}" Style="{StaticResource Dim}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0">
              <Run Text="Adopting drives the header from" />
              <Run Text="{Binding FanSourceGpuName, Mode=OneWay}" FontWeight="SemiBold"
                   Foreground="{StaticResource Title}" />
              <Run Text="and checks it responds before handing it over." />
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Adopted headers -->
        <ItemsControl ItemsSource="{Binding Fans}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource Card}" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                <StackPanel>

                  <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}"
                             TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

                  <UniformGrid Columns="4" Margin="0,14,0,0">
                    <StackPanel>
                      <TextBlock Text="{Binding DutyText}" Style="{StaticResource Metric}" />
                      <TextBlock Text="duty" Style="{StaticResource Dim}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding RpmText}" Style="{StaticResource Metric}" />
                      <TextBlock Text="speed" Style="{StaticResource Dim}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding SourceTempText}" Style="{StaticResource Metric}" />
                      <TextBlock Text="source temperature" Style="{StaticResource Dim}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding ModeText}" Style="{StaticResource Metric}" />
                      <TextBlock Text="controlled by" Style="{StaticResource Dim}" />
                    </StackPanel>
                  </UniformGrid>

                  <TextBlock Foreground="{StaticResource Warn}" FontSize="12" Margin="0,10,0,0"
                             TextWrapping="Wrap"
                             Text="This header never confirmed an RPM response, so it may not be the fan you meant. Use Identify to check."
                             Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVis}}" />

                  <TextBlock Foreground="{StaticResource Warn}" FontSize="12" Margin="0,10,0,0"
                             TextWrapping="Wrap"
                             Text="This header is no longer present on the board. It is left on the BIOS curve."
                             Visibility="{Binding Present, Converter={StaticResource NotBoolToVis}}" />

                  <Border Background="#FF2E323B" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                    <StackPanel>
                      <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Style="{StaticResource Body}" />
                      <TextBlock Text="{Binding OverrideExpiryText}" Style="{StaticResource Dim}" Margin="0,3,0,0"
                                 Visibility="{Binding HasOverrideExpiry, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                  </Border>

                  <!-- The curve. Drag a point to move it, double-click to add, right-click to
                       remove. Commits happen on gesture boundaries only — see FanCurveEditor. -->
                  <TextBlock Text="Fan curve" Style="{StaticResource Body}" Margin="0,18,0,0" />
                  <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,6"
                             Text="Drag a point to move it, double-click an empty spot to add one, right-click a point to remove it. The orange line is the GPU's temperature right now." />

                  <Border Background="#FF1B1D22" CornerRadius="6" Padding="4">
                    <ui:FanCurveEditor x:Name="Curve" Height="190"
                                       Points="{Binding CurvePoints, Mode=OneWay}"
                                       MinTemperatureC="{Binding MinTemperatureC, Mode=OneWay}"
                                       MaxTemperatureC="{Binding MaxTemperatureC, Mode=OneWay}"
                                       CurrentTemperatureC="{Binding CurrentTemperatureC, Mode=OneWay}"
                                       CurrentPercent="{Binding CurrentPercent, Mode=OneWay}"
                                       Loaded="CurveEditor_Loaded" />
                  </Border>

                  <!-- Manual duty. Same commit-on-release rule as the GPU sliders. -->
                  <StackPanel Margin="0,16,0,0">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Dim}">
                        <Run Text="{Binding DutySliderPercent, StringFormat={}{0:0}%, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="Hold at a fixed duty" Style="{StaticResource Body}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100"
                            Value="{Binding DutySliderPercent, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                            Thumb.DragStarted="FanSlider_DragStarted"
                            Thumb.DragCompleted="FanSlider_DragCompleted"
                            KeyUp="FanSlider_KeyUp" />
                  </StackPanel>

                  <WrapPanel Margin="0,12,0,0">
                    <Button Content="Back to the curve" Click="FanAuto_Click" />
                    <Button Content="Identify (10 s at full)" Click="IdentifyFan_Click" />
                    <Button Content="Hand back to BIOS" Click="ReleaseFan_Click" />
                  </WrapPanel>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="14,8" Background="#FF2A2E36">
      <TextBlock Text="{Binding LastMessage}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
